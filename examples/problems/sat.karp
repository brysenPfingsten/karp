#lang karp/problem-definition

(require karp/lib/cnf
         karp/lib/mapping)

(decision-problem #:name sat
                  #:instance ([φ is-a (cnf)])
                  #:certificate (mapping #:from (variables-of φ)
                                         #:to (the-set-of boolean)))

; instance , certificate -> boolean
(define-sat-verifier x c^sat
  (∀ [C ∈ (clauses-of (φ x))]
     (∃ [l ∈ (literals-of C)]
        (or (and
             (positive-literal? l) (lookup c^sat (underlying-var l)))
            (and
             (negative-literal? l) (not (lookup c^sat (underlying-var l))))))))

#;(cnf ((set 'x1) ∨ 'x2 ∨ (¬'x3)))



